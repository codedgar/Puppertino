{
  "name": "@codedgar/puppertino",
  "version": "2.0.0",
  "description": "A CSS framework based on Human Guidelines from Apple",
  "main": "./dist/css/puppertino.css",
  "style": "./dist/css/puppertino.css",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "style": "./dist/css/puppertino.css",
      "default": "./dist/css/puppertino.css"
    },
    "./min": "./dist/css/puppertino.min.css",
    "./desktop": "./dist/css/puppertino-desktop.css",
    "./desktop/min": "./dist/css/puppertino-desktop.min.css",
    "./mobile": "./dist/css/puppertino-mobile.css",
    "./mobile/min": "./dist/css/puppertino-mobile.min.css",
    "./css/*": "./dist/css/*",
    "./js/*": "./src/js/*",
    "./buttons": "./dist/css/buttons.css",
    "./modals": "./dist/css/modals.css",
    "./forms": "./dist/css/forms.css",
    "./tabs": "./dist/css/tabs.css",
    "./actions": "./dist/css/actions.css",
    "./cards": "./dist/css/cards.css",
    "./layout": "./dist/css/layout.css",
    "./typography": "./dist/css/typography.css",
    "./colors": "./dist/css/colors.css",
    "./color-palette": "./dist/css/color_palette.css",
    "./dark-mode": "./dist/css/dark_mode.css",
    "./segmented-controls": "./dist/css/segmented-controls.css",
    "./shadows": "./dist/css/shadows.css",
    "./materials": "./dist/css/materials.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "src/js/*.js"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:css": "npm run build:css:full && npm run build:css:desktop && npm run build:css:mobile",
    "build:css:full": "lightningcss --minify --bundle --browserslist dist/css/puppertino.css -o dist/css/puppertino.min.css",
    "build:css:desktop": "lightningcss --minify --bundle --browserslist dist/css/puppertino-desktop.css -o dist/css/puppertino-desktop.min.css",
    "build:css:mobile": "lightningcss --minify --bundle --browserslist dist/css/puppertino-mobile.css -o dist/css/puppertino-mobile.min.css",
    "prepublishOnly": "npm run build:css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codedgar/Puppertino.git"
  },
  "keywords": [
    "css",
    "framework",
    "ui",
    "uikit",
    "apple",
    "macos",
    "design-system",
    "components"
  ],
  "author": "Codedgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codedgar/Puppertino/issues"
  },
  "homepage": "https://github.com/codedgar/Puppertino#readme",
  "devDependencies": {
    "lightningcss-cli": "^1.33.0"
  }
}
