---
import Doc from '../../layouts/Doc.astro';
import { nav } from '../../data/nav.js';
const base = import.meta.env.BASE_URL;

const foundations = nav.find((s) => s.heading === 'Foundations');
---

<Doc title="Foundations" description="The building blocks that define how Puppertino looks and feels: colors, typography, materials, dark mode, and icons.">
  <p>
    The building blocks that define how Puppertino looks and feels. Colors, typography, materials, and spacing form the visual language every component builds on. Start here before reaching for components.
  </p>

  <div class="tile-grid" style="margin-top: 40px;">
    {foundations.groups.flatMap((group) => group.items).map((item) => (
      <a href={`${base}${item.slug}`} class={`tile ${foundations.tint}`}>
        <div class="tile-art">
          <i class={`ph-bold ${item.icon}`}></i>
        </div>
        <span class="tile-label">{item.label}</span>
      </a>
    ))}
  </div>
</Doc>
