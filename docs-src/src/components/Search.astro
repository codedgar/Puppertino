---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';
import { nav } from '../data/nav.js';

const base = import.meta.env.BASE_URL;

// Resolve Phosphor's bold SVG assets at build time and inline them.
// Ninja Keys uses Shadow DOM, so global icon-font CSS does not reach inside.
const __dirname = dirname(fileURLToPath(import.meta.url));
const phosphorDir = resolve(__dirname, '../../node_modules/@phosphor-icons/core/assets/bold');

const ph = (name: string) => {
  try {
    const raw = readFileSync(`${phosphorDir}/${name}-bold.svg`, 'utf-8');
    // Ninja Keys ignores external CSS, so size and spacing go inline on the SVG.
    return raw.replace('<svg ', '<svg width="18" height="18" style="margin-right: 12px; flex-shrink: 0;" ');
  } catch (err) {
    console.error(`Phosphor icon not found: ${name}`);
    return '';
  }
};

// nav.js stores icon-font class names (ph-moon); the SVG files drop the prefix.
const phNav = (icon: string | undefined) => ph((icon ?? 'file').replace(/^ph-/, ''));

// Every searchable page comes from nav.js, so the palette can never
// drift from the sidebar. Hub pages get an "<Section> overview" entry;
// anchor children (the Forms sub-entries) become deep links.
const data = nav.flatMap((section) => [
  {
    id: section.hub,
    title: `${section.heading} overview`,
    section: section.heading,
    href: `${base}${section.hub}`,
    icon: phNav(section.icon),
  },
  ...section.groups.flatMap((group) =>
    group.items.flatMap((item) => [
      {
        id: item.slug,
        title: item.label,
        section: section.heading,
        href: `${base}${item.slug}`,
        icon: phNav(item.icon),
      },
      ...(item.children ?? []).map((child) => ({
        id: `${item.slug}${child.anchor}`,
        title: child.label,
        section: section.heading,
        href: `${base}${item.slug}${child.anchor}`,
        icon: phNav(child.icon ?? item.icon),
      })),
    ])
  ),
]);

data.push({
  id: 'github',
  title: 'GitHub repository',
  section: 'Resources',
  href: 'https://github.com/codedgar/Puppertino',
  icon: ph('github-logo'),
});
---

<!-- Rendered at the end of <body>, outside the sidebar: a fixed modal
     inside the drawer would be clipped to it on small screens. -->
<ninja-keys
  id="ninja-keys"
  placeholder="Search the docs..."
  hideBreadcrumbs
></ninja-keys>

<script>
  import 'ninja-keys';
</script>

<script is:inline define:vars={{ data }}>
  function setup() {
    const ninja = document.querySelector('ninja-keys');
    const trigger = document.getElementById('search-trigger');
    if (!ninja) return;

    ninja.data = data.map((item) => ({
      id: item.id,
      title: item.title,
      section: item.section,
      icon: item.icon,
      href: item.href,
      handler: () => {
        if (item.href.startsWith('http')) {
          window.open(item.href, '_blank');
        } else {
          window.location.href = item.href;
        }
      },
    }));

    if (trigger) {
      trigger.addEventListener('click', () => ninja.open());
    }

    // Slash key as quick-open
    document.addEventListener('keydown', (event) => {
      if (
        event.key === '/' &&
        !(event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement)
      ) {
        event.preventDefault();
        ninja.open();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>

<style>
  /* Style ninja-keys with Puppertino tokens */
  :global(ninja-keys) {
    --ninja-width: 640px;
    --ninja-z-index: 400;
    --ninja-backdrop-filter: blur(20px) saturate(180%);
    --ninja-overflow-background: rgba(0, 0, 0, 0.5);
    --ninja-text-color: var(--text-primary);
    --ninja-font: var(--font);
    --ninja-font-size: 15px;
    --ninja-top: 20%;
    --ninja-key-border-radius: 4px;
    --ninja-accent-color: var(--accent);
    --ninja-secondary-background-color: var(--bg-sidebar);
    --ninja-secondary-text-color: var(--text-secondary);
    --ninja-selected-background: var(--bg-sidebar);
    --ninja-selected-text-color: var(--text-primary);
    --ninja-icon-size: 18px;
    --ninja-icon-color: var(--text-secondary);
    --ninja-separate-border: 1px solid var(--border-subtle);
    --ninja-modal-background: var(--bg-page);
    --ninja-modal-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
    --ninja-actions-height: 380px;
    --ninja-group-text-color: var(--text-tertiary);
    --ninja-footer-background: var(--bg-sidebar);
    --ninja-placeholder-color: var(--text-tertiary);
  }
</style>
