---
const base = import.meta.env.BASE_URL;
const backdrop = `${base}images/material-backdrop.jpg`;
---

<div class="material-grid">
  <div class="material-grid-bg" style={`background-image: url('${backdrop}');`}>
    <slot />
  </div>
</div>

<style>
  .material-grid {
    margin: 24px 0 32px;
  }

  .material-grid-bg {
    position: relative;
    padding: 24px;
    border-radius: 14px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  @media (max-width: 768px) {
    .material-grid-bg {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
